# =====================================================================
# =================== DO NOT MODIFY THIS PART =========================
# =====================================================================

# DIRECTORIES
WSLDADIR:=$(WSLDADIR)/
OBJDIR:=$(OBJDIR)/
BINDIR:=$(BINDIR)/

SRCDIR=$(WSLDADIR)hpc-engine/gpe/
INCLUDEDIR=$(WSLDADIR)hpc-engine/

WDATAINC=$(WSLDADIR)lib/wdata/c/
WDATASRC=$(WSLDADIR)lib/wdata/c/

WDERIVINC=$(WSLDADIR)lib/wderiv/c/
WDERIVSRC=$(WSLDADIR)lib/wderiv/c/

WINTERPINC=$(WSLDADIR)lib/winterp/c/
WINTERPSRC=$(WSLDADIR)lib/winterp/c/

WDATADIR=$(WSLDADIR)lib/wdata/c/
WDERIVDIR=$(WSLDADIR)lib/wderiv/c/
WINTERPDIR=$(WSLDADIR)lib/winterp/c/

# DEPENDENCIES
DEPS = pca_io.h pca_kernels.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_derivative.h pca_edf.h pca_dens.h pca_logger.h \
       ccpca_kernels.h ccpca_dens.h cpca_checkpoint.h \
       cpca_kernels.h cpca_derivative.h cpca_dens.h wslda_potdens.h \
       wslda_reproducibility.h wslda_errors.h wslda_wavevectors.h tdwslda_static_vars.h jdb.h wslda_predefines_test.h \
       wslda_api_version.h ../VERSION.h
NVCCDEPS = gpe_utils.h gpe_timing.h
DEPSLOCAL = predefines.h machine.h
WDATADEPS = wdata.h
WDERIVDEPS = wderiv.h
WINTERPDEPS = winterp.h

# SOURCE FILES
DEPSSRCS = wslda_potdens.c pca_utils.c wslda_writevars.c wslda_reproducibility.c wslda_errors.c
POTENTIALSSRC=get_ext_potentials.cu
CONNECTORSRC=gpe_engine_api.cu
ENGINESRC=gpe_engine.cu
UTILSSRC=gpe_utils.cu
IMAGSRC=gpe_imag.c
REALSRC=gpe_real.c

# OBJECT FILES
WDATALIB = wdata.o
WDERIVLIB = wderiv.o
WINTERPLIB = winterp.o

# FLAGS
NOWORNING := -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used"
CFLAGS := $(CFLAGS) -I$(INCLUDEDIR) -I$(WDATAINC) -I$(WDERIVINC) -I$(WINTERPINC) -I./ -DTDWSLDA
NVCCFLAGS := $(NVCCFLAGS) $(NOWORNING) $(PARAMS) -I$(INCLUDEDIR) -I./ -DTDWSLDA

# TRANSFORMATIONS
## DEPENDENCIES
DEPSOBJS := $(addprefix $(OBJDIR),$(DEPSSRCS:.c=.o))
DEPSSRCS := $(addprefix $(INCLUDEDIR),$(DEPSSRCS))
DEPS := $(addprefix $(INCLUDEDIR),$(DEPS))

## SOURCE FILES
POTENTIALSOBJ := $(addprefix $(OBJDIR),$(POTENTIALSSRC:.cu=.o))
POTENTIALSSRC := $(addprefix $(SRCDIR),$(POTENTIALSSRC))

CONNECTOROBJ := $(addprefix $(OBJDIR),$(CONNECTORSRC:.cu=.o))
CONNECTORSRC := $(addprefix $(SRCDIR),$(CONNECTORSRC))

ENGINEOBJ := $(addprefix $(OBJDIR),$(ENGINESRC:.cu=.o))
ENGINESRC := $(addprefix $(SRCDIR),$(ENGINESRC))

UTILSOBJ := $(addprefix $(OBJDIR),$(UTILSSRC:.cu=.o))
UTILSSRC := $(addprefix $(SRCDIR),$(UTILSSRC))

IMAGOBJ := $(addprefix $(OBJDIR),$(IMAGSRC:.c=.o))
IMAGSRC := $(addprefix $(SRCDIR),$(IMAGSRC))

REALOBJ := $(addprefix $(OBJDIR),$(REALSRC:.c=.o))
REALSRC := $(addprefix $(SRCDIR),$(REALSRC))

COREOBJ := $(ENGINEOBJ) $(CONNECTOROBJ) $(UTILSOBJ) $(POTENTIALSOBJ)

## WDATA
WDATADEPS := $(addprefix $(WDATAINC),$(WDATADEPS))
WDATAOBJS := $(addprefix $(OBJDIR),$(WDATALIB:.c=.o))
WDATALIB := $(addprefix $(WDATASRC),$(WDATALIB))

WDERIVDEPS := $(addprefix $(WDERIVINC),$(WDERIVDEPS))
WDERIVOBJS := $(addprefix $(OBJDIR),$(WDERIVLIB:.c=.o))
WDERIVLIB := $(addprefix $(WDERIVSRC),$(WDERIVLIB))

WINTERPDEPS := $(addprefix $(WINTERPINC),$(WINTERPDEPS))
WINTERPOBJS := $(addprefix $(OBJDIR),$(WINTERPLIB:.c=.o))
WINTERPLIB := $(addprefix $(WINTERPSRC),$(WINTERPLIB))

# MAKE
all: imag real

imag: core oimag

real: core oreal

core: dirs engine engine_connector utils potentials

oimag: $(IMAGOBJ) $(COREOBJ) $(DEPSOBJS) $(WDATAOBJS) $(WDERIVOBJS) $(WINTERPOBJS)
	cat $(WSLDADIR)VERSION.h
	$(CXX) $(CFLAGS) $(LIBS) $^ -o $(BINDIR)gpe_imag

oreal: $(REALOBJ) $(COREOBJ) $(DEPSOBJS) $(WDATAOBJS) $(WDERIVOBJS) $(WINTERPOBJS)
	cat $(WSLDADIR)VERSION.h
	$(CXX) $(CFLAGS) $(LIBS) $^ -o $(BINDIR)gpe_real

$(IMAGOBJ): $(IMAGSRC) $(DEPSLOCAL) $(DEPS) $(SRCDIR)gpe_engine_api.h
	$(CXX) $(CFLAGS) -c -o $@ $<

$(REALOBJ): $(REALSRC) $(DEPSLOCAL) $(DEPS) $(SRCDIR)gpe_engine_api.h
	$(CXX) $(CFLAGS) -c -o $@ $<

$(OBJDIR)wslda_reproducibility.o: $(INCLUDEDIR)wslda_reproducibility.c $(INCLUDEDIR)wslda_reproducibility.h $(INCLUDEDIR)pca_settings.h $(DEPSLOCAL) logger.h problem-definition.h
	python $(INCLUDEDIR)reproducibility.py $(OBJDIR)
	$(CXX) $(CFLAGS) -I$(OBJDIR) -c -o $@ $<

$(OBJDIR)%.o: $(INCLUDEDIR)%.c $(DEPS) $(DEPSLOCAL) $(WDATADEPS) $(WDERIVDEPS)
	$(CXX) $(CFLAGS) -c -o $@ $<

$(OBJDIR)%.o: $(WDATASRC)%.c $(DEPS) $(WDATADEPS)
	$(CXX) $(CFLAGS) -c -o $@ $<

$(OBJDIR)%.o: $(WDERIVSRC)%.c $(DEPS) $(WDERIVDEPS)
	$(CXX) $(CFLAGS) -DWSLDA -c -o $@ $<

$(OBJDIR)%.o: $(WINTERPSRC)%.c $(DEPS) $(WINTERPDEPS)
	$(CXX) $(CFLAGS) -DWSLDA -c -o $@ $< 

engine: $(ENGINESRC)
	$(NVCC) $(NVCCFLAGS) -c $(ENGINESRC) -o $(ENGINEOBJ) 

engine_connector: $(CONNECTORSRC)
	$(NVCC) $(NVCCFLAGS) -c $(CONNECTORSRC) -o $(CONNECTOROBJ)

utils: $(UTILSSRC)
	$(NVCC) $(NVCCFLAGS) -c $(UTILSSRC) -o $(UTILSOBJ)

potentials: $(POTENTIALSSRC)
	$(NVCC) $(NVCCFLAGS) -c $(POTENTIALSSRC) -o $(POTENTIALSOBJ)

dirs:
	mkdir -p $(OBJDIR)
	mkdir -p $(BINDIR)

clean:
	rm -f $(OBJDIR)*.o
	rm -f $(BINDIR)gpe_imag
	rm -f $(BINDIR)gpe_real
	rm -f $(OBJDIR)reproducibility.h

ver:
	$(NVCC) --version

.PHONY: clean all ver dirs
