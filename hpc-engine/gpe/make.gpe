SRCDIR=$(WSLDADIR)/hpc-engine/gpe/
BINDIR:=$(BINDIR)/

MAINCODE1=$(SRCDIR)gpe_jj_exp.cu
MAINCODE2=$(SRCDIR)gpe_jj_2d.cu
MAINCODE3=$(SRCDIR)gpe_jj_2d_dynamic_barrier.cu

all: engine main_code_1 main_code_2 main_code_3

engine:
	$(NVCC) -c $(SRCDIR)gpe_engine.cu -o $(BINDIR)gpe_engine.o $(NVCCFLAGS) -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)

main_code_1:
	$(NVCC) -c $(MAINCODE1) $(NVCCFLAGS) -o $(BINDIR)gpe.o -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)
	$(NVCC) gpe.o $(BINDIR)gpe_engine.o -o $(BINDIR)gpe1 $(LIBS)

main_code_2:
	$(NVCC) -c $(MAINCODE2) $(NVCCFLAGS) -o $(BINDIR)gpe.o -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)
	$(NVCC) gpe.o gpe_engine.o -o $(BINDIR)gpe2 $(LIBS)

main_code_3:
	$(NVCC) -c $(MAINCODE3) $(NVCCFLAGS) -o $(BINDIR)gpe.o -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)
	$(NVCC) gpe.o gpe_engine.o -o $(BINDIR)gpe3 $(LIBS)
