# =====================================================================
# =================== DO NOT MODIFY THIS PART =========================
# =====================================================================

# DIRECTORIES
WSLDADIR:=$(WSLDADIR)/
OBJDIR:=$(OBJDIR)/
BINDIR:=$(BINDIR)/

SRCDIR=$(WSLDADIR)hpc-engine/gpe/
INCLUDEDIR=$(WSLDADIR)hpc-engine/

WDATAINC=$(WSLDADIR)lib/wdata/c/
WDATASRC=$(WSLDADIR)lib/wdata/c/

WDERIVINC=$(WSLDADIR)lib/wderiv/c/
WDERIVSRC=$(WSLDADIR)lib/wderiv/c/

WINTERPINC=$(WSLDADIR)lib/winterp/c/
WINTERPSRC=$(WSLDADIR)lib/winterp/c/

#PROJDIR=$(WSLDADIR)gpe-project-template/
WDATADIR=$(WSLDADIR)lib/wdata/c/
WDERIVDIR=$(WSLDADIR)lib/wderiv/c/
WINTERPDIR=$(WSLDADIR)lib/winterp/c/

# DEPENDENCIES
DEPS = pca_io.h pca_kernels.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_derivative.h pca_edf.h pca_dens.h pca_logger.h \
       ccpca_kernels.h ccpca_dens.h cpca_checkpoint.h \
       cpca_kernels.h cpca_derivative.h cpca_dens.h wslda_potdens.h \
       wslda_reproducibility.h wslda_errors.h wslda_wavevectors.h tdwslda_static_vars.h jdb.h sldae_functional.h wslda_predefines_test.h \
       wslda_api_version.h ../VERSION.h
DEPSLOCAL = predefines.h machine.h
WDATADEPS = wdata.h
WDERIVDEPS = wderiv.h
WINTERPDEPS = winterp.h

# SOURCE FILES
DEPS_SRCS_FILES = wslda_potdens.c pca_utils.c wslda_writevars.c wslda_reproducibility.c wslda_errors.c sldae_functional.c
ENGINE_SRCS_FILES=gpe_engine.cu
IMAG_SRC_FILES=gpe_imag.cu 
REAL_SRC_FILES=gpe_real.cu

# OBJECT FILES
WDATALIB = wdata.o
WDERIVLIB = wderiv.o
WINTERPLIB = winterp.o

# FLAGS
CFLAGS := $(CFLAGS) -I$(INCLUDEDIR) -I$(WDATAINC) -I$(WDERIVINC) -I$(WINTERPINC) -I./ -DTDWSLDA
NVCCFLAGS := $(NVCCFLAGS) -I$(INCLUDEDIR) -I./ -DTDWSLDA
NOWORNING := -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used"

# TRANSFORMATIONS
## DEPENDENCIES
DEPSSRCS := $(addprefix $(INCLUDEDIR),$(DEPS_SRCS_FILES))
DEPSOBJS := $(addprefix $(OBJDIR),$(DEPS_SRCS_FILES:.c=.o))

## SOURCE FILES
ENGINESRCS := $(addprefix $(SRCDIR),$(ENGINE_SRCS_FILES))
ENGINEOBJ := $(addprefix $(OBJDIR),$(ENGINE_SRCS_FILES:.cu=.o))

IMAGSRC := $(addprefix $(SRCDIR),$(IMAG_SRC_FILES))
IMAGOBJ := $(addprefix $(OBJDIR),$(IMAG_SRC_FILES:.cu=.o))

REALSRC := $(addprefix $(SRCDIR),$(REAL_SRC_FILES))
REALOBJ := $(addprefix $(OBJDIR),$(REAL_SRC_FILES:.cu=.o))

## WDATA
WDATADEPS := $(addprefix $(WDATAINC),$(WDATADEPS))
WDATAOBJS := $(addprefix $(OBJDIR),$(WDATALIB:.c=.o))
WDATALIB := $(addprefix $(WDATASRC),$(WDATALIB))

WDERIVDEPS := $(addprefix $(WDERIVINC),$(WDERIVDEPS))
WDERIVOBJS := $(addprefix $(OBJDIR),$(WDERIVLIB:.c=.o))
WDERIVLIB := $(addprefix $(WDERIVSRC),$(WDERIVLIB))

WINTERPDEPS := $(addprefix $(WINTERPINC),$(WINTERPDEPS))
WINTERPOBJS := $(addprefix $(OBJDIR),$(WINTERPLIB:.c=.o))
WINTERPLIB := $(addprefix $(WINTERPSRC),$(WINTERPLIB))

# TEST
test2:
	echo $(OBJDIR)

test:
	ca
	cat $(ENGINESRCS)
	cat $(ENGINEOBJ)
	cat $(IMAGSRC)
	cat $(IMAGOBJ)
	cat $(REALSRC)
	cat $(REALOBJ)
	cat $(DEPSSRCS)
	cat	 $(DEPSOBJS)

# MAKE
all: core imag real

imag: core imag

real: core real

core: dirs engine $(DEPSOBJS)

dimag: $(IMAGSRCS)
	$(NVCC) -c $(IMAGSRC) $(NVCCFLAGS) -o $(OBJDIR)gpe_imag.o -I$(PROJDIR) -I$(INCLUDEDIR) -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)
	ld -relocatable $(OBJDIR)gpe_imag.o $(OBJDIR)pca_utils.o -o $(OBJDIR)gpe_merged_imag.o
	$(NVCC) $(OBJDIR)gpe_merged_imag.o $(OBJDIR)gpe_engine.o -o $(BINDIR)gpe_imag $(LIBS)

objreal: $(SRCDIR)gpe_real.cu $(DEPSLOCAL) $(DEPS)
	$(NVCC) -c $(SRCDIR)gpe_real.cu $(NVCCFLAGS) -o $(OBJDIR)gpe_real.o -I$(PROJDIR) -I$(INCLUDEDIR) -Xcudafe "--diag_suppress=declared_but_not_referenced --diag_suppress=set_but_not_used" $(PARAMS)

dreal: $(REALOBJS)
	cat $(WSLDADIR)VERSION.h
	$(NVCC) $^ -o $(BINDIR)gpe_real $(LIBS)	

$(OBJDIR)%.o: $(INCLUDEDIR)%.c $(DEPS) $(DEPSLOCAL) $(WDATADEPS) $(WDERIVDEPS)
	$(CXX) $(CFLAGS) -c -o $@ $<

$(OBJDIR)%.o: $(WDATASRC)%.c $(DEPS) $(WDATADEPS)
	$(CXX) $(CFLAGS) -c -o $@ $<

$(OBJDIR)%.o: $(WDERIVSRC)%.c $(DEPS) $(WDERIVDEPS)
	$(CXX) $(CFLAGS) -DWSLDA -c -o $@ $<

$(OBJDIR)%.o: $(WINTERPSRC)%.c $(DEPS) $(WINTERPDEPS)
	$(CXX) $(CFLAGS) -DWSLDA -c -o $@ $< 

engine: $(ENGINESRCS)
	$(NVCC) -c $(ENGINESRCS) -o $(ENGINEOBJ) $(NVCCFLAGS) $(NOWORNING) $(PARAMS)

dirs:
	mkdir -p $(OBJDIR)
	mkdir -p $(BINDIR)

clean:
	rm -f $(OBJDIR)*.o
	rm -f $(BINDIR)gpe_real
	rm -f $(BINDIR)gpe_imag

ver:
	$(NVCC) --version

.PHONY: clean all ver dirs