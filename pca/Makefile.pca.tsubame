# module load cuda intel intel-mpi fftw/3.3.6

MPICC = mpiicc
NVCC = nvcc  
SRC_DIR = ./ 

INCLUDECC = pca_io.h pca_kernels.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_derivative.h pca_edf.h pca_dens.h pca_logger.h reduce_suffle.h
INCLUDENVCC = pca_macro.h pca_settings.h pca_uext.h pca_derivative.h pca_edf.h reduce_suffle.h


# for tsubame
CCFLAGS =  
CCLIB =  -lcudart -lcufft -lm
CCFLAGS = -O3 -DTARGET_MACHINE=TSUBAME
NVCCFLAGS = -arch sm_60 -O3 

OBJ = pca_derivative.o pca_kernels.o pca_dens.o reduce_suffle.o
OBJmpi =  pca.o pca_checkpoint.o
# OBJmpi =  pca.o test_derivative_accuracy.o
all: $(OBJ) $(OBJmpi)
	$(MPICC) $(OBJ) $(OBJmpi) -o pca -O3 $(PARAMS) $(CCLIB)

$(OBJ): %.o: %.cu $(INCLUDENVCC)
	$(NVCC) $(NVCCFLAGS) -c $< 

$(OBJmpi): %.o: %.c $(INCLUDECC)
	$(MPICC) $(CCFLAGS) $(CCLIB)  -c $< 

clean: 	
	rm *.o pca
