# module swap PrgEnv-cray PrgEnv-intel
# module load cray-fftw

MPICC = cc 
SRC_DIR = ./ 
INCLUDECC = pca_io.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_edf.h pca_logger.h s2dpca_edf.h s3dpca_grid.h s2dpca_densities.h s2dpca_me.h s2dpca_fft.h s2dpca_uext.h sxdpca_broyden.h
# For SCALAPACK library
CCLIB =  -lfftw3  -I${MKLROOT}/include ${MKLROOT}/lib/intel64/libmkl_scalapack_lp64.a -Wl,--start-group ${MKLROOT}/lib/intel64/libmkl_intel_lp64.a ${MKLROOT}/lib/intel64/libmkl_sequential.a ${MKLROOT}/lib/intel64/libmkl_core.a ${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group -lpthread -lm -ldl

# For ELPA Library
# CCLIB =  -lfftw3 -lm -L/usr/lib64/openmpi/lib -lscalapack -I/usr/local/include/elpa-2018.11.001 -L/usr/local/lib/ -lelpa
CCFLAGS = -O3
OBJmpi =  s2dpca.o s2dpca_fft.o s2dpca_me.o s2dpca_densities.o sxdpca_broyden.o sxdpca_inversematrix.o


all: $(OBJmpi)
	$(MPICC) $(CCFLAGS) $(OBJmpi) -o s2dpca -O3 $(PARAMS) $(CCLIB)

$(OBJmpi): %.o: %.c $(INCLUDECC)
	$(MPICC) $(CCFLAGS) $(CCLIB)  -c $< 
	
clean: 	
	rm *.o s2dpca

