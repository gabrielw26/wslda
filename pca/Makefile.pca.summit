# module load cuda

MPICC = cc 
NVCC = nvcc 
SRC_DIR = ./ 
INCLUDECC = pca_io.h pca_kernels.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_derivative.h pca_edf.h pca_dens.h pca_logger.h
INCLUDENVCC = pca_macro.h pca_settings.h pca_uext.h pca_derivative.h pca_edf.h
CCFLAGS = -I$(OMPI_DIR)/include 
CCLIB =  -L$(OMPI_DIR)/lib -L$(CUDA_DIR)/targets/ppc64le-linux/lib/stubs -lmpi_ibm -lnvidia-ml -L$(CUDA_DIR)/lib64 -lcudart -lcufft -lm
CCFLAGS = -O3 -DTARGET_MACHINE=TITAN
NVCCFLAGS = -O3 -arch=sm_60  
OBJ = pca_derivative.o pca_kernels.o pca_dens.o reduce_suffle.o
OBJmpi =  pca.o pca_checkpoint.o

all: $(OBJ) $(OBJmpi)
	$(MPICC) $(OBJ) $(OBJmpi) -o pca -O3 $(PARAMS) $(CCLIB)

$(OBJ): %.o: %.cu $(INCLUDENVCC)
	$(NVCC) $(NVCCFLAGS) -c $< 

$(OBJmpi): %.o: %.c $(INCLUDECC)
	$(MPICC) $(CCFLAGS) $(CCLIB)  -c $< 

clean: 	
	rm *.o pca

