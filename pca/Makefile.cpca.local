MPICC = mpicc 
NVCC = nvcc 
SRC_DIR = ./ 


INCLUDECC = pca_io.h cpca_kernels.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h cpca_derivative.h pca_edf.h cpca_dens.h pca_logger.h cpca_checkpoint.h
INCLUDENVCC = pca_macro.h pca_settings.h pca_uext.h cpca_derivative.h pca_edf.h

# for gw laptop
CCFLAGS = -I/usr/local/cuda/include/ 
CCLIB =  -L/usr/local/cuda/lib64 -lcudart -lcufft -I/usr/local/cuda/include/ -lm
CCFLAGS = -O3 -DCODEDIM=2 -DTARGET_MACHINE=TITAN
NVCCFLAGS = -arch sm_30 -O3 

OBJ = cpca_derivative.o cpca_kernels.o cpca_dens.o
OBJmpi =  cpca.o cpca_checkpoint.o

all: $(OBJ) $(OBJmpi)
	$(MPICC) $(OBJ) $(OBJmpi) -o cpca -O3 $(PARAMS) $(CCLIB)

$(OBJ): %.o: %.cu $(INCLUDENVCC)
	$(NVCC) $(NVCCFLAGS) -c $< 

$(OBJmpi): %.o: %.c $(INCLUDECC)
	$(MPICC) $(CCFLAGS) $(CCLIB)  -c $< 

clean: 	
	rm *.o cpca
