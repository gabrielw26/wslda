# Compilation for local laptop

MPICC = mpicc 
SRC_DIR = ./ 
INCLUDECC = pca_io.h pca_macro.h pca_settings.h pca_uniform.h pca_utils.h pca_edf.h pca_logger.h s2dpca_edf.h s3dpca_me.h s3dpca_fft.h s3dpca_testfun.h s3dpca_densities.h s3dpca_uext.h s3dpca_inittype4.h
CCLIB =  -lfftw3 -lm -L/usr/lib64/openmpi/lib -lscalapack 
# For ELPA Library
# CCLIB =  -lfftw3 -lm -L/usr/lib64/openmpi/lib -lscalapack -I/usr/local/include/elpa-2018.11.001 -L/usr/local/lib/ -lelpa
CCFLAGS = -O3 
OBJmpi =  s3dpca.o s3dpca_fft.o s3dpca_densities.o s3dpca_me.o s3dpca_inittype4.o


all: $(OBJmpi)
	$(MPICC) $(OBJmpi) -o s3dpca -O3 $(PARAMS) $(CCLIB)

$(OBJmpi): %.o: %.c $(INCLUDECC)
	$(MPICC) $(CCFLAGS) $(CCLIB)  -c $< 
	
clean: 	
	rm *.o s3dpca

