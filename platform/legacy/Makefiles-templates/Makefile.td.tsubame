# COMPILER FLAGS
CFLAGS= -O3 
NVCCFLAGS = -arch sm_60 -O3 

# LIBRARIES
LIBS=-lcudart -lcufft -lm


# ----- DO NOT MODIFY -----
include $(WSLDADIR)hpc-engine/mk.td
