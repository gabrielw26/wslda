# COMPILER
CXX=mpiicc

# DIRECTORY SETTINGS (must end with /)
WSLDADIR=/work/TDSLDA20/share/wslda/
OBJDIR=./obj/
BINDIR=./

# COMPILER FLAGS
CFLAGS= -std=c11 -O3 -I/work/TDSLDA20/share/FFTW3/include -mkl=cluster -DM_PI=3.14159265358979323846 -DM_PI_2=1.570796326794896558 
LIBS=/work/TDSLDA20/share/FFTW3/lib/libfftw3.a -lmkl_scalapack_lp64 -lmkl_blacs_intelmpi_lp64 -lpthread -lm -ldl -mkl=cluster 

include mk.st


 
