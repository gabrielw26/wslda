# LOAD BEFORE COMPILATION
# 
# module load cuda

# COMPILERS
CXX = cc
NVCC = nvcc 

# DIRECTORY SETTINGS
OBJDIR=./obj/
BINDIR=./
WSLDADIR=../hpc-engine/
WDATADIR=../lib-wdata/

# COMPILER FLAGS
CFLAGS= -std=gnu99 -O3 -I$(OMPI_DIR)/include -DTARGET_MACHINE=TITAN
NVCCFLAGS = -arch sm_60 -O3 

# LIBRARIES
LIBS=-L$(OMPI_DIR)/lib -L$(CUDA_DIR)/targets/ppc64le-linux/lib/stubs -lmpi_ibm -lnvidia-ml -L$(CUDA_DIR)/lib64 -lcudart -lcufft -lm


include mk.td

