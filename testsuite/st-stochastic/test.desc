# This test generates a 1D solution by the BdG equations.
# The solution provided in the ref folder was benchmarked against
#  independent calculations by Piotr Magierski and Dimitri Lazarou, 
#  with their own code. 
# We got overlap between these two independent runs up to very high precision. 
# Thus, this solution can be trusted.   

tag: st-stoch-1d
exec: pwd
# restore from reproducibility pack
exec: cp ref/ho-r1_input.txt input.txt
exec: cp ref/ho-r1_logger.h logger.h
exec: cp ref/ho-r1_problem-definition.h problem-definition.h
exec: cp ref/ho-r1_predefines.h predefines.h
exec: cp ref/ho-r1_machine.h machine.h
exec: cp $WSLDA/templates/dwarf/st/Makefile .
exec: cp $WSLDA/templates/dwarf/st/env.sh .
exec: make 1d EXTRA_CFLAGS="-DTESTSUITE"
test: st-wslda-1d
exec: timeout 360 mpirun -np 4 ./st-wslda-1d input.txt
test: ho-r1_testsuite.ok
diff: ho-r1.ref ref/ho-r1.ref
