# These tests read wave-functions from st-calcs
# --------------------------------------------------------------------------
# read 1d wf
# --------------------------------------------------------------------------
tag: read-1d_1d
exec: pwd
exec: cp ../td-templates-full/*.h .
exec: cp ../td-templates-full/input.cp* .
exec: echo "inprefix  ../st-writewf/wf1d" >> input.cp.read.txt
exec: echo "inittype   1" >> input.cp.read.txt
exec: echo "spinsymmetry   1" >> input.cp.read.txt
exec: head -n 9 ../st-writewf/wf1d_uniform.ref > ./wf1d_uniform.ref
exec: make -f ../td-templates-full/Makefile.1.s clean
exec: make -f ../td-templates-full/Makefile.1.s 1d
test: td-wslda-1d
exec: timeout 300 mpirun -np 8 ./td-wslda-1d input.cp.read.txt
test: test.cp.read_testsuite.ok
diff: test.cp.read.cmp wf1d_uniform.ref

tag: read-1d_2d
