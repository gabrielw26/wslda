
# --------------------------------------------------------------------------
# Spin imbalanced system
# --------------------------------------------------------------------------
tag: ss0-1d
exec: pwd
exec: cp ../td-templates-full/Makefile.0.s .
exec: make -f ../td-templates-full/Makefile.0.s clean
exec: make -f ../td-templates-full/Makefile.0.s 1d
test: td-wslda-1d
exec: cp input.txt.1 input.ss0.txt
exec: rm -rf test.ss0-1d*
exec: echo "outprefix  test.ss0-1d" >> input.ss0.txt
exec: echo "params7       1" >> input.ss0.txt
exec: timeout 3600 mpirun -np 8 ./td-wslda-1d input.ss0.txt
test: test.ss0-1d_testsuite.ok
diff: test.ss0-1d.cmp test.ss0-1d_uniform.ref

