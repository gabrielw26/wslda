# --------------------------------------------------------------------------
# Spin symmetric system, no noise
# --------------------------------------------------------------------------
tag: ss1-noise0-1d
exec: cp ../st-templates-fast/*.h .
exec: cp ../st-templates-fast/input* .
exec: rm -rf test.ss1.noise0*
exec: make -f ../st-templates-fast/Makefile clean
exec: make -f ../st-templates-fast/Makefile 1d
test: st-wslda-1d
exec: mpirun -np 20 ./st-wslda-1d input.ss1.noise0.txt
test: test.ss1.noise0_testsuite.ok
diff: test.ss1.noise0.cmp test.ss1.noise0_uniform.ref

tag: ss1-noise0-2d
exec: rm -rf test.ss1.noise0*
exec: make -f ../st-templates-fast/Makefile 2d
test: st-wslda-2d
exec: mpirun -np 20 ./st-wslda-2d input.ss1.noise0.txt
test: test.ss1.noise0_testsuite.ok
diff: test.ss1.noise0.cmp test.ss1.noise0_uniform.ref

tag: ss1-noise0-3d
exec: rm -rf test.ss1.noise0*
exec: make -f ../st-templates-fast/Makefile 3d
test: st-wslda-3d
exec: mpirun -np 20 ./st-wslda-3d input.ss1.noise0.txt
test: test.ss1.noise0_testsuite.ok
diff: test.ss1.noise0.cmp test.ss1.noise0_uniform.ref
