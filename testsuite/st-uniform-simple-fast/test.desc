# --------------------------------------------------------------------------
# Spin imbalanced system, no noise, linear mixing
# --------------------------------------------------------------------------
tag: ss0-noise0-1d
exec: rm -rf test.ss0.noise0*
exec: make -f ../st-templates-fast/Makefile clean
exec: make -f ../st-templates-fast/Makefile 1d
test: st-wslda-1d
exec: mpirun -np 20 ./st-wslda-1d input.ss0.noise0.txt
test: test.ss0.noise0.cmp
diff: test.ss0.noise0.cmp ref.ss0
