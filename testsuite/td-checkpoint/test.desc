# These tests check is checkpoint write/read works ok
# --------------------------------------------------------------------------
# 1d
# --------------------------------------------------------------------------
tag: write-1d
exec: pwd
exec: cp ../td-templates-full/*.h .
exec: cp ../td-templates-full/input.cp* .
exec: rm -rf test.cp.wrt*
exec: make -f ../td-templates-full/Makefile.0.s clean
exec: make -f ../td-templates-full/Makefile.0.s 1d
test: td-wslda-1d
exec: timeout 300 mpirun -np 8 ./td-wslda-1d input.cp.wrt.txt
test: test.cp.wrt_testsuite.ok
diff: test.cp.wrt.cmp test.cp.wrt_uniform.ref

tag: read-1d
exec: rm -rf test.cp.read*
exec: make -f ../td-templates-full/Makefile.0.s 1d
test: td-wslda-1d
exec: timeout 300 mpirun -np 8 ./td-wslda-1d input.cp.read.txt
test: test.cp.read_testsuite.ok
diff: test.cp.read.cmp test.cp.wrt_uniform.ref

