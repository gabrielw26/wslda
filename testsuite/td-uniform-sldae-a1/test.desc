# ----------------------- SPHERICAL CUT-OFF --------------------------------

# --------------------------------------------------------------------------
# Spin symmetric system
# --------------------------------------------------------------------------
tag: ss1-1d-s
exec: pwd
exec: cp ../td-templates-full/*.h .
exec: cp ../td-templates-full/input* .
exec: rm -rf test.ss1*
exec: make -f ../td-templates-full/Makefile.1.s clean
exec: make -f ../td-templates-full/Makefile.1.s 1d
test: td-wslda-1d
exec: timeout 300 mpirun -np 8 ./td-wslda-1d input.ss1.txt
test: test.ss1_testsuite.ok
diff: test.ss1.cmp test.ss1_uniform.ref

tag: ss1-2d-s
exec: rm -rf test.ss1*
exec: make -f ../td-templates-full/Makefile.1.s 2d
test: td-wslda-2d
exec: timeout 300 mpirun -np 8 ./td-wslda-2d input.ss1.txt
test: test.ss1_testsuite.ok
diff: test.ss1.cmp test.ss1_uniform.ref

tag: ss1-3d-s
exec: rm -rf test.ss1*
exec: make -f ../td-templates-full/Makefile.1.s 3d
test: td-wslda-3d
exec: timeout 300 mpirun -np 8 ./td-wslda-3d input.ss1.txt
test: test.ss1_testsuite.ok
diff: test.ss1.cmp test.ss1_uniform.ref


