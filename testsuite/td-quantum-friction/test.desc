# -------------- 1D ---------------------
tag: qf-1d-slda
exec: pwd
exec: cp -f predefines.h.template predefines.h
exec: echo "#define NX 64" >> predefines.h
exec: echo "#define NY 16" >> predefines.h
exec: echo "#define NZ 16" >> predefines.h
exec: echo "#define FUNCTIONAL SLDA" >> predefines.h
exec: cp -f input.txt.template input.txt
exec: echo "outprefix qfslda1d" >> input.txt
exec: make 1d
test: td-wslda-1d
exec: timeout 3600 mpirun -np 8 ./td-wslda-1d input.txt
test: qfslda1d.ok
diff: qfslda1d.cmp qfslda1d.ref

