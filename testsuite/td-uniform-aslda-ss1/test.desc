
# --------------------------------------------------------------------------
# Spin symmetric system
# --------------------------------------------------------------------------
tag: ss1-1d
exec: rm -rf test.ss1*
exec: make clean
exec: make 1d
test: td-wslda-1d
exec: mpirun -np 8 ./td-wslda-1d input.ss1.txt
test: test.ss1.cmp
diff: test.ss1.cmp ref.ss1

