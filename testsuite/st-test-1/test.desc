tag: test1 
exec: source env.sh
exec: rm -rf test1*
exec: make clean
exec: make 1d
test: st-wslda-1d
exec: mpirun -np 20 ./st-wslda-1d input.1.txt
test: test1.cmp
diff: test1.cmp ref.test1


