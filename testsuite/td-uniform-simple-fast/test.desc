
# --------------------------------------------------------------------------
# Spin imbalanced system
# --------------------------------------------------------------------------
tag: ss0-1d
exec: cp ../td-templates-fast/*.h .
exec: cp ../td-templates-fast/ref* .
exec: cp ../td-templates-fast/input* .
exec: rm -rf test.ss0*
exec: make -f ../td-templates-fast/Makefile.0 clean
exec: make -f ../td-templates-fast/Makefile.0 1d
test: td-wslda-1d
exec: mpirun -np 8 ./td-wslda-1d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp ref.ss0

tag: ss0-2d
exec: rm -rf test.ss0*
exec: make -f ../td-templates-fast/Makefile.0 2d
test: td-wslda-2d
exec: mpirun -np 8 ./td-wslda-2d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp ref.ss0

tag: ss0-3d
exec: rm -rf test.ss0*
exec: make -f ../td-templates-fast/Makefile.0 3d
test: td-wslda-3d
exec: mpirun -np 8 ./td-wslda-3d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp ref.ss0

