# The code tests the sensitivity of the results with respect to the DX.
# Only 1D code is tested here.

# --------------------------------------------------------------------------
# --------> 128x32x32
# --------------------------------------------------------------------------
tag: a0
exec: cp predefines.h.1 predefines.h
exec: make -f ../st-templates-full/Makefile.c clean
exec: make -f ../st-templates-full/Makefile.c 1d
test: st-wslda-1d
exec: cp ref/input.txt input.txt.run
exec: echo "outprefix a0" >> input.txt.run
exec: echo "temperature 0.0" >> input.txt.run
exec: timeout 600 mpirun -np 20 ./st-wslda-1d input.txt.run
test: test_testsuite.ok
diff: a0.cmp ref/c0.ref

