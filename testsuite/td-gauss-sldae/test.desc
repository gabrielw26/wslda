# --------------------------------------------------------------------------
# Smaller time step dt -> dt/2
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Spin symmetric system, AB3AM4
# --------------------------------------------------------------------------
tag: ss1-1d-34-dt2
exec: pwd
exec: cp ../td-templates-full/Makefile.1.s.34 .
exec: make -f ../td-templates-full/Makefile.1.s.34 clean
exec: make -f ../td-templates-full/Makefile.1.s.34 1d
test: td-wslda-1d
exec: cp input.txt.1 input.ss1.txt
exec: rm -rf test.ss1-1d*
exec: echo "outprefix  test.ss1-1d" >> input.ss1.txt
exec: echo "dt 0.00175" >> input.ss1.txt
exec: echo "timesteps 572" >> input.ss1.txt
exec: timeout 7200 mpirun -np 8 ./td-wslda-1d input.ss1.txt
test: test.ss1-1d_testsuite.ok
diff: test.ss1-1d.cmp ref/test.ss1-1d.cmp.ref

tag: ss1-2d-34-dt2
exec: make -f ../td-templates-full/Makefile.1.s.34 clean
exec: make -f ../td-templates-full/Makefile.1.s.34 2d
test: td-wslda-2d
exec: cp input.txt.2 input.ss1.txt
exec: rm -rf test.ss1-2d*
exec: echo "outprefix  test.ss1-2d" >> input.ss1.txt
exec: echo "dt 0.00175" >> input.ss1.txt
exec: echo "timesteps 572" >> input.ss1.txt
exec: timeout 7200 mpirun -np 8 ./td-wslda-2d input.ss1.txt
