# LOAD BEFORE COMPILATION
# 
# module load cuda/9.0

# COMPILERS
CXX=mpicc
NVCC=nvcc 

# DIRECTORY SETTINGS 
WSLDADIR=$(WSLDA)
OBJDIR=./obj/
# folder where executable binary will be placed (will be created automatically)
BINDIR=./

# COMPILER FLAGS
CFLAGS= -std=gnu99 -O3 -I/usr/local/cuda-9.0/include/ \
        -DTARGET_MACHINE=DWARF -DTESTSUITE -DSPINSYMMETRY_MODE -DREGULARIZATION_SCHEME=SPHERICAL_CUTOFF \
        -DINTEGRATION_SCHEME=AB5AM5
NVCCFLAGS = -arch sm_35 -O3 -std=c++03 -DSPINSYMMETRY_MODE -DREGULARIZATION_SCHEME=SPHERICAL_CUTOFF -DINTEGRATION_SCHEME=AB5AM5

# LIBRARIES
LIBS=-L/usr/local/cuda-9.0/lib64 -lcudart -lcufft -lfftw3 -lstdc++ -lm


# ----- DO NOT MODIFY -----
include $(WSLDADIR)/hpc-engine/mk.td
