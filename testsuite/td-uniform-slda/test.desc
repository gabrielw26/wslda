# ----------------------- SPHERICAL CUT-OFF --------------------------------
# --------------------------------------------------------------------------
# Spin imbalanced system
# --------------------------------------------------------------------------
tag: ss0-1d-s
exec: pwd
exec: cp ../td-templates-full/*.h .
exec: cp ../td-templates-full/input* .
exec: rm -rf test.ss0*
exec: make -f ../td-templates-full/Makefile.0.s clean
exec: make -f ../td-templates-full/Makefile.0.s 1d
test: td-wslda-1d
exec: timeout 300 mpirun -np 8 ./td-wslda-1d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp test.ss0_uniform.ref

tag: ss0-2d-s
exec: rm -rf test.ss0*
exec: make -f ../td-templates-full/Makefile.0.s 2d
test: td-wslda-2d
exec: timeout 300 mpirun -np 8 ./td-wslda-2d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp test.ss0_uniform.ref

tag: ss0-3d-s
exec: rm -rf test.ss0*
exec: make -f ../td-templates-full/Makefile.0.s 3d
test: td-wslda-3d
exec: timeout 300 mpirun -np 8 ./td-wslda-3d input.ss0.txt
test: test.ss0_testsuite.ok
diff: test.ss0.cmp test.ss0_uniform.ref

