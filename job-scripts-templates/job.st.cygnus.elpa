#!/bin/bash                                                                                          
#---------- qsub option ----------                                                                   
#PBS -N JOB_NAME                  # YOUR JOB NAME
#PBS -A TDSLDA20                                                                                     
#PBS -q gpu                                                                                          
#PBS -l elapstim_req=00:10:00     # SET WALLTIME                                                                     

#---------- MPI option ----------                                                                    
#PBS -b 1                         # SET NUMBER OF NODES                                                               
#PBS -T intmpi                                                                                      
#PBS -v NQSV_MPI_VER=19.0.5                                                       

#---------- Others (optional) ----------                                                             
#PBS -o output.o                  # SET NAME OF OUTPUT FILE                                                                    
#PBS -e error.e                   # SET NAME OF ERROR FILE                                                                    
#PBS -M your@email                # SET YOUR E-MAIL FOR NOTIFICATION

## -------- WIKI INFO -------
## https://gitlab.fizyka.pw.edu.pl/gabrielw/wslda/-/wikis/home
## 
## ------ QUEUE SYSTEM ------
## For submission use:
##      qsub job.sh
## For checking status use:
##      qstat
## To kill job use:
##      qdel pid
## 
## ------ COMPUTATION -------     
## For computation it is recomended to use location (create there your subfolder):
##      cd /work/TDSLDA20/


#---------- Program execution ----------                                                             
cd $PBS_O_WORKDIR
pwd
source env.sh


## NOTE: YOU MUST ASSURE: -np=-b*24 (each node has 24 CPUs)
##       do NOT modify parameters except `-np` value!
mpirun ${NQSII_MPIOPTS} -np 48 -ppn 24 ./st-wslda-3d input.txt 

